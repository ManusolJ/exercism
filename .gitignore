# --- Java / Gradle / Maven -------------------------------------------------
.gradle/
build/
bin/
out/
target/
*.class
*.jar
*.war
*.ear
# ...but keep the Gradle wrapper: it is what makes `./gradlew test` work
# for anyone who clones this without a matching Gradle install. The leading
# `**/` matters - each exercise has its own wrapper nested under <track>/<exercise>/,
# so a root-anchored path would never match.
!**/gradle/wrapper/gradle-wrapper.jar
hs_err_pid*
replay_pid*


